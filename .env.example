# --- LLM ---
# Leave ANTHROPIC_API_KEY unset to run fully offline using the bundled
# deterministic MockLLM (great for demoing the graph/loop with zero setup).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- GitHub ---
# Leave GITHUB_TOKEN / GITHUB_REPO unset to operate on the local ./demo_repo
# folder instead of a real GitHub repository (branch/commit/PR are simulated
# on disk under ./pr_output).
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo

# --- Local/demo mode paths ---
LOCAL_REPO_PATH=./demo_repo
PR_OUTPUT_DIR=./pr_output
TICKETS_DIR=./demo_repo/tickets
POLICY_PATH=config/policies.yaml
